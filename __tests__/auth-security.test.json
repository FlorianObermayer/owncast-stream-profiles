[
  {
    "name": "a control character in return_to cannot redirect off-site",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"e415b834637f49eb1a4f2ef392c24361d5a791bd656d261e72161c9668c750d5\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=secret&return_to=%2F%09%2Fexample.com",
          "expect": {
            "status": 302,
            "headers": {
              "Location": "/"
            }
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=secret&return_to=%2F%0A%2Fexample.com",
          "expect": {
            "status": 302,
            "headers": {
              "Location": "/"
            }
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=secret&return_to=%2F%0D%2Fexample.com",
          "expect": {
            "status": 302,
            "headers": {
              "Location": "/"
            }
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=secret&return_to=%2F%00%2Fexample.com",
          "expect": {
            "status": 302,
            "headers": {
              "Location": "/"
            }
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=secret&return_to=%2F%7F%2Fexample.com",
          "expect": {
            "status": 302,
            "headers": {
              "Location": "/"
            }
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=secret&return_to=%2Fplugins%2Fx%3Fy%3Dz",
          "expect": {
            "status": 302,
            "headers": {
              "Location": "/plugins/x?y=z"
            }
          }
        }
      }
    ]
  },
  {
    "name": "a drained sign-in budget refuses before hashing, even for a correct password",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"e415b834637f49eb1a4f2ef392c24361d5a791bd656d261e72161c9668c750d5\"}]",
        "auth-attempt": "{\"tokens\":0,\"at\":9999999999999}"
      }
    },
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=secret",
          "expect": {
            "status": 429,
            "bodyContains": "Too many sign-in attempts"
          }
        }
      }
    ],
    "expect": {
      "sessionGrants": [],
      "userRegistrations": []
    }
  },
  {
    "name": "a typo does not block the next correct sign-in",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"e415b834637f49eb1a4f2ef392c24361d5a791bd656d261e72161c9668c750d5\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=wrong",
          "expect": {
            "status": 401
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=secret",
          "expect": {
            "status": 302
          }
        }
      }
    ],
    "expect": {
      "sessionGrants": [
        {
          "userId": "u-a:c1"
        }
      ]
    }
  },
  {
    "name": "a drained per-username budget refuses that name only",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"e415b834637f49eb1a4f2ef392c24361d5a791bd656d261e72161c9668c750d5\",\"rounds\":32}]",
        "auth-attempt-user:2bd806c97f0e00af1a1fc3328fa763a9": "{\"tokens\":0,\"at\":9999999999999}"
      }
    },
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=secret",
          "expect": {
            "status": 429,
            "bodyContains": "Too many sign-in attempts"
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=carol&password=wrong",
          "expect": {
            "status": 401
          }
        }
      }
    ],
    "expect": {
      "sessionGrants": []
    }
  },
  {
    "name": "a cross-site sign-in is refused",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"e415b834637f49eb1a4f2ef392c24361d5a791bd656d261e72161c9668c750d5\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded",
            "Sec-Fetch-Site": "cross-site"
          },
          "body": "user=alice&password=secret",
          "expect": {
            "status": 403,
            "bodyContains": "did not come from this site"
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded",
            "Origin": "https://evil.example",
            "X-Forwarded-Host": "stream.example"
          },
          "body": "user=alice&password=secret",
          "expect": {
            "status": 403
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded",
            "Sec-Fetch-Site": "same-origin"
          },
          "body": "user=alice&password=secret",
          "expect": {
            "status": 302
          }
        }
      }
    ]
  },
  {
    "name": "sign-out is a same-origin POST with a GET confirmation page",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"e415b834637f49eb1a4f2ef392c24361d5a791bd656d261e72161c9668c750d5\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/auth/logout",
          "expect": {
            "status": 200,
            "bodyContains": "Sign out of this stream"
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/logout",
          "headers": {
            "Sec-Fetch-Site": "cross-site"
          },
          "expect": {
            "status": 403,
            "bodyContains": "did not come from this site"
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/logout",
          "headers": {
            "Sec-Fetch-Site": "same-origin"
          },
          "expect": {
            "status": 302
          }
        }
      }
    ]
  },
  {
    "name": "a credential written at the previous round count still verifies and is upgraded",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=secret",
          "expect": {
            "status": 302
          }
        }
      }
    ],
    "expect": {
      "kv": {
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"e415b834637f49eb1a4f2ef392c24361d5a791bd656d261e72161c9668c750d5\",\"rounds\":32}]"
      },
      "sessionGrants": [
        {
          "userId": "u-a:c1"
        }
      ]
    }
  },
