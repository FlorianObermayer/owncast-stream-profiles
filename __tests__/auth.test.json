        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"},{\"id\":\"c2\",\"user\":\"huhu\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
