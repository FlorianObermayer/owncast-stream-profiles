  {
    "name": "onAuthCheck renews a session issued by the active profile",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]",
        "auth-session:u-a:c1": "a|c1"
      }
    },
    "events": [
      {
        "authCheck": {
          "user": {
            "id": "u-a:c1",
            "displayName": "alice"
          },
          "expect": {
            "action": "refresh"
          }
        }
      }
    ]
  },
  {
    "name": "onAuthCheck revokes a session when a different profile becomes active",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"},{\"id\":\"b\",\"name\":\"B\"}]",
        "active-profile": "b",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]",
        "auth:b": "[{\"id\":\"c9\",\"user\":\"carol\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"75d0519fc852bbb89a70d6af155d68ad648f6374789d04a76aeada0a9599c283\"}]",
        "auth-session:u-a:c1": "a|c1"
      }
    },
    "events": [
      {
        "authCheck": {
          "user": {
            "id": "u-a:c1",
            "displayName": "alice"
          },
          "expect": {
            "action": "deny"
          }
        }
      }
    ]
  },
  {
    "name": "onAuthCheck revokes a session whose credential was deleted",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]",
        "auth-session:u-a:gone": "a|gone"
      }
    },
    "events": [
      {
        "authCheck": {
          "user": {
            "id": "u-a:gone",
            "displayName": "someone"
          },
          "expect": {
            "action": "deny"
          }
        }
      }
    ]
  },
  {
    "name": "onAuthCheck does not disturb a session while the profile is open",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a"
      }
    },
    "events": [
      {
        "authCheck": {
          "user": {
            "id": "u-a:open",
            "displayName": "Guest"
          },
          "expect": {
            "action": "ok"
          }
        }
      }
    ]
  },
  {
    "name": "the credential summary never carries a salt or a hash",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/admin/api/auth?id=a",
          "authenticated": true,
          "expect": {
            "status": 200,
            "body": "{\"credentials\":[{\"id\":\"c1\",\"user\":\"alice\",\"passwordOnly\":false}]}"
          }
        }
      }
    ]
  },
  {
    "name": "adding a credential stores only a hash of the password",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a"
      }
    },
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/admin/api/auth",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"id\":\"a\",\"action\":\"add\",\"user\":\"alice\",\"password\":\"hunter2\"}",
          "authenticated": true,
          "expect": {
            "status": 200,
            "bodyContains": "\"passwordOnly\":false"
          }
        }
      }
    ]
  },
  {
    "name": "a duplicate username is refused",
