[
  {
    "name": "an open profile grants a session instead of showing a form",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a"
      }
    },
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/?return_to=%2Fhls%2Findex.m3u8",
          "expect": {
            "status": 302,
            "headers": {
              "Location": "/hls/index.m3u8"
            }
          }
        }
      }
    ],
    "expect": {
      "userRegistrations": [
        {
          "authId": "a:open",
          "displayName": "Guest"
        }
      ],
      "sessionGrants": [
        {
          "userId": "u-a:open"
        }
      ]
    }
  },
  {
    "name": "with no active profile the gate stays closed and says why",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/",
          "expect": {
            "status": 200,
            "bodyContains": "No profile is active"
          }
        }
      }
    ],
    "expect": {
      "sessionGrants": []
    }
  },
  {
    "name": "a profile with credentials shows the login form",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/",
          "expect": {
            "status": 200,
            "bodyContains": "This stream is private"
          }
        }
      }
    ],
    "expect": {
      "sessionGrants": []
    }
  },
  {
    "name": "the form posts to the page that rendered it",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=secret",
          "expect": {
            "status": 302
          }
        }
      }
    ],
    "expect": {
      "sessionGrants": [
        {
          "userId": "u-a:c1"
        }
      ]
    }
  },
  {
    "name": "the correct password grants a session and returns to the original path",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=secret&return_to=%2Fhls%2Findex.m3u8",
          "expect": {
            "status": 302,
            "headers": {
              "Location": "/hls/index.m3u8"
            }
          }
        }
      }
    ],
    "expect": {
      "userRegistrations": [
        {
          "authId": "a:c1",
          "displayName": "alice"
        }
      ],
      "sessionGrants": [
        {
          "userId": "u-a:c1"
        }
      ]
    }
  },
  {
    "name": "a wrong password re-renders the form and grants nothing",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=alice&password=wrong",
          "expect": {
            "status": 401,
            "bodyContains": "That username and password do not match"
          }
        }
      }
    ],
    "expect": {
      "sessionGrants": [],
      "userRegistrations": []
    }
  },
  {
    "name": "a named credential rejects the wrong username even with the right password",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "user=bob&password=secret",
          "expect": {
            "status": 401
          }
        }
      }
    ],
    "expect": {
      "sessionGrants": []
    }
  },
  {
    "name": "a password-only credential accepts any username",
