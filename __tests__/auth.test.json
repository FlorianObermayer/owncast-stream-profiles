    "expect": {
      "userRegistrations": [
        {
          "authId": "a:c2",
          "displayName": "Guest"
        }
      ],
      "sessionGrants": [
        {
          "userId": "u-a:c2"
        }
      ]
    }
  },
  {
    "name": "the Authorization header lets a non-browser client in",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/",
          "headers": {
            "Authorization": "Basic YWxpY2U6c2VjcmV0"
          },
          "expect": {
            "status": 302,
            "headers": {
              "Location": "/"
            }
          }
        }
      }
    ],
    "expect": {
      "sessionGrants": [
        {
          "userId": "u-a:c1"
        }
      ]
    }
  },
  {
    "name": "a wrong Authorization header is refused without rendering the form",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/",
          "headers": {
            "Authorization": "Basic YWxpY2U6d3Jvbmc="
          },
          "expect": {
            "status": 401,
            "bodyContains": "Invalid credentials"
          }
        }
      }
    ],
    "expect": {
      "sessionGrants": []
    }
  },
  {
    "name": "a crafted return_to cannot redirect off-site",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
