      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
      }
    },
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/admin/api/auth",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"id\":\"a\",\"action\":\"add\",\"user\":\"alice\",\"password\":\"another\"}",
          "authenticated": true,
          "expect": {
            "status": 400,
            "bodyContains": "already exists"
          }
        }
      }
    ]
  },
  {
    "name": "clearing a profile's credentials opens it",
    "given": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\"}]",
        "active-profile": "a",
        "auth:a": "[{\"id\":\"c1\",\"user\":\"alice\",\"salt\":\"0123456789abcdef0123456789abcdef\",\"hash\":\"347a985ec7168356313c41db6be8a43bbf49dc635408e87dc538020b81310acf\"}]"
