[
  {
    "name": "the admin API is gated by the host",
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/admin/api/state",
          "expect": {
            "status": 401
          }
        }
      }
    ]
  },
  {
    "name": "state never carries a password or image bytes",
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/admin/api/state",
          "authenticated": true,
          "expect": {
            "status": 200,
            "bodyContains": "\"owncastUrl\""
          }
        }
      }
    ],
    "expect": {
      "kv": {}
    }
  },
  {
    "name": "saving fills in typed defaults for a bare profile",
    "events": [
      {
        "http": {
          "method": "POST",
          "path": "/admin/api/profiles",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"profiles\":[{\"id\":\"a\",\"name\":\"A\"}]}",
          "authenticated": true,
          "expect": {
            "status": 200
          }
        }
      }
    ],
    "expect": {
      "kv": {
        "profiles": "[{\"id\":\"a\",\"name\":\"A\",\"skip\":[],\"serverName\":\"\",\"streamTitle\":\"\",\"summary\":\"\",\"welcomeMessage\":\"\",\"offlineMessage\":\"\",\"extraPageContent\":\"\",\"tags\":[],\"nsfw\":false,\"directoryEnabled\":false,\"autoplay\":\"always\",\"chatDisabled\":false,\"chatJoinMessagesEnabled\":false,\"suggestedUsernames\":[],\"hideViewerCount\":false,\"disableSearchIndexing\":false,\"federationGoLiveMessage\":\"\",\"videoServingEndpoint\":\"\",\"customStyles\":\"\",\"customJavascript\":\"\",\"externalActions\":[],\"socialHandles\":[],\"logo\":false,\"favicon\":false}]"
